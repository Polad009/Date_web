# ==========================================
# 💖 DATE WEB - ENVIRONMENT VARIABLES
# ==========================================
# Vercel-də Settings -> Environment Variables bölməsinə əlavə edə bilərsən:

# 1. Telegram Bot Token (Telegram-da @BotFather-dən aldığın bot token):
VITE_TELEGRAM_BOT_TOKEN=

# 2. Telegram Chat ID (Telegram-da @userinfobot-dan aldığın sənin şəxsi ID-in):
VITE_TELEGRAM_CHAT_ID=

# 3. Formspree Form ID (Könüllü - Email bildirişi üçün https://formspree.io):
VITE_FORMSPREE_ID=

# 4. Discord Webhook URL (Könüllü):
VITE_DISCORD_WEBHOOK_URL=
